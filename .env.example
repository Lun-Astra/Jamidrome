# Set this when the request/player pages sit behind a reverse proxy on
# separate hostnames rather than being reached directly on :9999/:9998 —
# there's no way to derive one hostname from the other in that setup.
REQUEST_PAGE_URL=https://aanvragenjam.example.com

# Host PIN for the web player page (and its Host panel). Change it here and
# run `docker compose up -d jam-backend`. 3 wrong PINs in 10 minutes lock PIN
# login for everyone for 10 minutes (see README, "Host PIN").
JAM_HOST_PIN=

# Guests need a live invite link (default on). Set to 0 for a LAN-only jam.
JAM_REQUIRE_INVITE=1

# Who may host from an app (LunaDrome) with Navidrome credentials.
# Empty = any Navidrome admin; otherwise comma-separated usernames.
JAM_HOST_USERS=
